{
  "name": "dsh-model-block-picker",
  "version": "1.0.0",
  "description": "DeepSeek Harness 模块化模型选择器：根据模型来源（Provider 如 CodeBuddy、Qoder、DeepSeek 等）分块展示，支持分块下钻、全局搜索与推理强度调节。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "model-selector",
    "model",
    "provider",
    "composer",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liu19666/dsh-model-block-picker.git"
  },
  "bugs": {
    "url": "https://github.com/liu19666/dsh-model-block-picker/issues"
  },
  "homepage": "https://github.com/liu19666/dsh-model-block-picker#readme",
  "author": "liu19666",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.png"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
